# Copy to .env.local (development) or set in your host's environment (production).
# Never commit real secrets.

# ---- Core ----
# Public origin(s) of the site, comma-separated, e.g. https://www.leyteleather.ca
# REQUIRED in production (CSRF origin check, payment redirects). Leave EMPTY for local
# development — the request host (http://localhost:3000) is used automatically.
APP_ORIGIN=
# SQLite file location (default: ./storage/leyte.db). Must be on persistent storage.
DATABASE_PATH=./storage/leyte.db
# Private directory for custom-order reference images (default: ./storage/uploads/custom-orders). Never inside /public.
UPLOAD_DIR=./storage/uploads/custom-orders
# Set to 1 ONLY when running behind a trusted reverse proxy/CDN that sets X-Forwarded-For.
TRUST_PROXY=0
# Random secret used to hash client IPs in security logs.
IP_HASH_SALT=change-me

# ---- Payments (Stripe) ----
# When both are set, checkout uses Stripe Checkout and the signed webhook confirms payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Business decisions — leave empty until confirmed by Leyte Leather:
# Comma-separated ISO country codes for shipping address collection, e.g. CA,US
STRIPE_SHIPPING_COUNTRIES=
# Comma-separated Stripe shipping rate IDs (shr_...)
STRIPE_SHIPPING_RATE_IDS=
# 1 to enable Stripe Tax (requires Stripe Tax configuration)
STRIPE_AUTOMATIC_TAX=0

# Local development only: payment simulator. Ignored when NODE_ENV=production.
PAYMENTS_MODE=development

# ---- Email ----
# resend | postmark. Without a provider: development writes to storage/dev-outbox/, production does not send.
MAIL_PROVIDER=
# Resend API key, or Postmark server token.
MAIL_API_KEY=
# Verified sender, e.g. Leyte Leather <orders@your-domain>
MAIL_FROM=
# Receives new paid-order and custom-order notifications.
BUSINESS_NOTIFICATION_EMAIL=

# ---- Testing only (ignored in production) ----
# Multiplies per-IP rate limits because all e2e traffic shares one IP.
RATE_LIMIT_SCALE=1
